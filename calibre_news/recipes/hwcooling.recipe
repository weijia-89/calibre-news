from calibre.web.feeds.news import BasicNewsRecipe

class HWCooling(BasicNewsRecipe):
    tags = ['tech']
    author = 'HWCooling'
    title = 'HWCooling'
    description = 'PC cooling and enthusiast hardware news.'
    oldest_article = 7
    compress_news_images = True
    scale_news_images = (1264, 1680)
    language = 'en'
    requires_version = (9, 0, 0)
    auto_cleanup = True

    # keep_only_tags = []

    remove_tags = [{'name': 'nav'}, {'name': 'header', 'attrs': {'class': 'site-header'}}, {'name': 'footer'}, {'name': 'aside'}, {'class_': 'sidebar'}, {'class_': 'advertisement'}, {'class_': 'ad'}, {'class_': 'social-share'}, {'id': 'comments'}, {'class_': 'comments'}, {'class_': 'related-posts'}]

    extra_css = 'img { max-width: 100%; height: auto; } body { font-family: serif; font-size: 12pt; }'

    feeds = [
        ('HWCooling', 'https://www.hwcooling.net/en/feed/'),
    ]

    # For review: drop for_review/hwcooling.html to bypass live fetch
    publication_type = 'blog'

from calibre.web.feeds.news import BasicNewsRecipe

class SaportaReport(BasicNewsRecipe):
    title = 'SaportaReport'
    oldest_article = 7
    compress_news_images = True
    scale_news_images = (1264, 1680)
    language = 'en'
    requires_version = (9, 0, 0)
    auto_cleanup = True

    # keep_only_tags = []
    # remove_tags = []

    # FIXME: verify RSS URL
    feeds = [
        ('SaportaReport', 'https://saportareport.com/feed/'),
    ]

    # For review: open the generated .html with `open saportareport/for_review.html`

from calibre.web.feeds.news import BasicNewsRecipe

class NewschoolHeadlines(BasicNewsRecipe):
    tags = ['news']
    author = 'The New School'
    title = 'In the Headlines'
    description = 'New School link roll.'
    oldest_article = 7
    compress_news_images = True
    scale_news_images = (1264, 1680)
    language = 'en'
    requires_version = (9, 0, 0)
    auto_cleanup = True

    # keep_only_tags = []

    remove_tags = [{'name': 'nav'}, {'name': 'header', 'attrs': {'class': 'site-header'}}, {'name': 'footer'}, {'name': 'aside'}, {'class_': 'sidebar'}, {'class_': 'advertisement'}, {'class_': 'ad'}, {'class_': 'social-share'}, {'id': 'comments'}, {'class_': 'comments'}, {'class_': 'related-posts'}]

    extra_css = 'img { max-width: 100%; height: auto; } body { font-family: serif; font-size: 12pt; }'

    feeds = []  # Uses parse_index() — custom scraper below

    def parse_index(self):
        """Scrape https://blogs.newschool.edu/news/in-the-headlines/ for outbound article links.

        Falls back to for_review/newschool_headlines.html if the live page is unreachable.
        Returns: [(section_name, [article_dict, ...]), ...]
        """
        import sys
        import urllib.request
        from pathlib import Path

        url = 'https://blogs.newschool.edu/news/in-the-headlines/'

        # Possible fallback locations (relative to CWD or the running script)
        fallback_paths = [
            Path('for_review') / 'newschool_headlines.html',
            Path(sys.argv[0]).parent / 'for_review' / 'newschool_headlines.html',
        ]

        # Try live fetch first; fall back to saved HTML on any failure
        html = None
        try:
            with urllib.request.urlopen(url, timeout=30) as response:
                html = response.read()
        except Exception:
            for fallback in fallback_paths:
                if fallback.exists():
                    html = fallback.read_bytes()
                    break

        if not html:
            return []

        # Calibre provides BeautifulSoup via calibre.ebooks.BeautifulSoup; fall back to bs4 for tests
        try:
            from calibre.ebooks.BeautifulSoup import BeautifulSoup
        except Exception:
            from bs4 import BeautifulSoup

        soup = BeautifulSoup(html, 'html.parser')
        content = soup.find('div', class_='entry-contentf')
        if not content:
            return []

        articles = []
        for link in content.find_all('a', class_='a-blockLink', href=True):
            title_tag = link.find('h4', class_='a-blockLink__title')
            title = title_tag.get_text(strip=True) if title_tag else link.get_text(strip=True)
            href = link['href']
            if title and href.startswith('http'):
                articles.append({'title': title, 'url': href})

        return [('In the Headlines', articles)] if articles else []

    # For review: drop for_review/newschool_headlines.html to bypass live fetch
    publication_type = 'news'
